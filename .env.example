# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard > Connect).
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32+-character-random-string"
# Public base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# Exposed to the browser for the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
